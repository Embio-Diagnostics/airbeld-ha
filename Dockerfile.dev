# syntax=docker/dockerfile:1
FROM ghcr.io/home-assistant/home-assistant:2026.10.1 AS dev
COPY vendor/wheels/airbeld_api_sdk-1.0.0-py3-none-any.whl /tmp/wheels/
RUN python -m pip install --no-cache-dir /tmp/wheels/airbeld_api_sdk-1.0.0-py3-none-any.whl \
    && rm -rf /tmp/wheels
COPY scripts/dev_bootstrap.py /opt/airbeld/dev_bootstrap.py
ENV PYTHONPATH=/config
ENTRYPOINT ["python", "/opt/airbeld/dev_bootstrap.py"]
